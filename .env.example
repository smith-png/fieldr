# Fieldr Supabase Configuration
# Note: Use the publishable or anon key only, never the service_role key.
# If these variables are omitted, Fieldr runs in offline Demo mode with localStorage and BroadcastChannel sync.

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
